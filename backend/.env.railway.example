NODE_ENV=production
PORT=5000

# Database
MONGO_URI=your-mongodb-connection-string

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# CORS
# Replace the railway URL below if your service domain is different.
CLIENT_ORIGIN=https://real-chat-time-web-production.up.railway.app,http://localhost,capacitor://localhost,ionic://localhost

# OTP
# Railway disables outbound SMTP on Free, Trial, and Hobby plans.
# Prefer Resend on Railway unless you are on Pro+ and have verified SMTP works.
OTP_PROVIDER=resend
OTP_EMAIL_FROM=Chatify <otp@yourdomain.com>
ALLOW_DEMO_OTP_IN_PRODUCTION=0
OTP_FALLBACK_TO_DEMO_ON_ERROR=0
OTP_TTL_MS=300000

# Resend API setup
RESEND_API_KEY=re_xxxxxxxxx

# Gmail app password setup (only for Railway Pro+ or non-Railway hosts with SMTP access)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
