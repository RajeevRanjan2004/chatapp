PORT=5000
# Example local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_clone
MONGO_URI=

# Used to sign JWTs (change in production)
JWT_SECRET=dev_secret_change_me

# Frontend origin for CORS + Socket.IO
# Examples:
# CLIENT_ORIGIN=http://localhost:3000,http://YOUR_PC_IP:3000,http://localhost,capacitor://localhost,ionic://localhost
CLIENT_ORIGIN=http://localhost:3000,http://localhost,capacitor://localhost,ionic://localhost

# OTP provider: demo | resend | gmail | smtp
# Use gmail/resend/smtp in production so OTP is sent by email only.
OTP_PROVIDER=gmail
ALLOW_DEMO_OTP_IN_PRODUCTION=0
OTP_FALLBACK_TO_DEMO_ON_ERROR=0

# OTP expiry in milliseconds
OTP_TTL_MS=300000

# Resend config for real email OTP
RESEND_API_KEY=
OTP_EMAIL_FROM=

# Gmail app-password config for real email OTP
GMAIL_USER=
GMAIL_PASSWORD=
GMAIL_SMTP_HOST=

# Generic SMTP config for real email OTP
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
