# Web on same machine
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Android emulator
# VITE_API_URL=http://10.0.2.2:5000/api
# VITE_SOCKET_URL=http://10.0.2.2:5000

# Real Android phone on same Wi-Fi (replace with your PC LAN IP)
# VITE_API_URL=http://192.168.1.5:5000/api
# VITE_SOCKET_URL=http://192.168.1.5:5000

# Note:
# If you do not set VITE_API_URL / VITE_SOCKET_URL, the app now falls back to:
# - Web: http://localhost:5000
# - Android emulator: http://10.0.2.2:5000

