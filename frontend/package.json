{
  "name": "chat-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "socket.io-client": "^4.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vite": "^5.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "android:apk": "cd android && gradlew.bat assembleDebug",
    "android:debug": "node ./node_modules/@capacitor/cli/bin/capacitor sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "node ./node_modules/@capacitor/cli/bin/capacitor sync android && cd android && gradlew.bat assembleRelease",
    "android:aab": "node ./node_modules/@capacitor/cli/bin/capacitor sync android && cd android && gradlew.bat bundleRelease"
  }
}
